<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- v0.8.0：メイン ウィンドウは Windows Forms、ダイアログは WPF。入口は Program.Main -->
    <StartupObject>Memopad.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <AssemblyName>MemoPad</AssemblyName>
    <!-- アイコンはユーザー提供のデザイン（クリーム色の文書に緑の罫線）。v0.8.0 で差し替え -->
    <ApplicationIcon>memopad.ico</ApplicationIcon>
    <RootNamespace>Memopad</RootNamespace>
    <Version>0.10.4</Version>
    <Product>MemoPad</Product>
    <Description>背景色と文字色を変えられるメモ帳</Description>
    <Copyright>mrgarita</Copyright>
    <!-- WPF0001：.NET 9 の Fluent テーマ（ThemeMode）は実験的 API 扱いのため警告を抑止する -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- 発行時にアプリ本体も事前コンパイル（ReadyToRun）し、起動時の JIT を減らす（v0.7.0）。
         フレームワークまで一体化する複合（Composite）は初回起動が大きく遅くなるので使わない -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms が暗黙に足す using は WPF の型名（Color, TextBox など）と衝突するので外す。
         Windows Forms の型は ColorPicker などで完全修飾して使う -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- ANSI（Shift_JIS, cp932）の読み書きに必要 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
    <!-- 本文のエディタ。v0.10.0 で RichEdit から Scintilla に替えた（FB-19）。
         RichEdit は日本語と英字が混ざる行のレイアウトが極端に遅く、大きなファイルで画面が固まる。
         Scintilla は同じ計算を空き時間に細切れで行うので止まらない（docs/site/step3 の 15 節）。
         7.1.1 以上が必要：起動時の電子署名の検証を切るスイッチ（ScintillaNativeLibrary.VerifyScintillaDll）が
         7.1.0 で入った（FB-22。7.1.0 は DLL 名を誤って出しているので使わない） -->
    <PackageReference Include="Scintilla5.NET" Version="7.1.1" />
  </ItemGroup>

  <!-- Scintilla5.NET のパッケージは、全 CPU 向けの Scintilla.dll／Lexilla.dll（runtimes\**）を Content として足す。
       WPF のビルドは Content のファイルごとに PresentationCore の属性（AssemblyAssociatedContentFile）を exe に付け、
       Windows Forms の初期化がそれを調べるときに PresentationCore（約 8 MB）が起動時に読み込まれてしまう（FB-22）。
       win-x64 向けに発行すると DLL は exe と同じフォルダーにも入るので、この Content は外す
       （探す場所は Program.Main で ScintillaNativeLibrary.SatelliteDirectory に指定している） -->
  <Target Name="RemoveScintillaContent" BeforeTargets="AssignTargetPaths;MarkupCompilePass1">
    <ItemGroup>
      <Content Remove="@(Content)" Condition="$([System.String]::new('%(Content.Link)').StartsWith('runtimes\'))" />
    </ItemGroup>
  </Target>

</Project>
