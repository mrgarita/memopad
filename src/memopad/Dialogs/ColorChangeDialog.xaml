<Window x:Class="Memopad.Dialogs.ColorChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="色変更"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
        背景色と文字色を 1 つのウィンドウで変える（step3 FB-3）。
        16 色は PICO-8 パレット。「その他の色...」は Windows 標準の色の設定ダイアログ。
        下のプレビューには現在のフォントで見本を出す。
    -->
    <Window.Resources>
        <!-- 色見本のボタン。選択中は太い枠で示す -->
        <Style x:Key="SwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#80808080" BorderThickness="1" CornerRadius="4">
                            <Border x:Name="Mark" BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" BorderThickness="0" CornerRadius="4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Mark" Property="BorderThickness" Value="3" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C0808080" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 背景色 -->
        <GroupBox Grid.Row="0" Grid.Column="0" Header="背景色(_B)" Padding="8">
            <StackPanel>
                <UniformGrid x:Name="BackgroundSwatches" Columns="4" HorizontalAlignment="Left" />
                <DockPanel Margin="3,10,3,0">
                    <Button DockPanel.Dock="Right" x:Name="BackgroundOtherButton" Padding="10,4" Click="BackgroundOther_Click"><AccessText Text="その他の色(_M)..." /></Button>
                    <Border x:Name="BackgroundCurrent" Width="24" Height="24" CornerRadius="4" BorderBrush="#80808080" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBlock x:Name="BackgroundHex" Margin="8,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- 文字色 -->
        <GroupBox Grid.Row="0" Grid.Column="2" Header="文字色(_T)" Padding="8">
            <StackPanel>
                <UniformGrid x:Name="ForegroundSwatches" Columns="4" HorizontalAlignment="Left" />
                <DockPanel Margin="3,10,3,0">
                    <Button DockPanel.Dock="Right" x:Name="ForegroundOtherButton" Padding="10,4" Click="ForegroundOther_Click"><AccessText Text="その他の色(_O)..." /></Button>
                    <Border x:Name="ForegroundCurrent" Width="24" Height="24" CornerRadius="4" BorderBrush="#80808080" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBlock x:Name="ForegroundHex" Margin="8,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- プレビュー -->
        <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Header="プレビュー" Margin="0,14,0,0" Padding="8">
            <Border x:Name="PreviewBorder" Height="88" CornerRadius="4" BorderBrush="#80808080" BorderThickness="1" Padding="12,8">
                <TextBlock x:Name="PreviewText" TextWrapping="Wrap"
                           Text="背景色と文字色を自由に変えられるメモ帳です。&#10;The quick brown fox jumps over the lazy dog. 0123456789" />
            </Border>
        </GroupBox>

        <!-- ボタン -->
        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Padding="12,6" Click="Reset_Click"><AccessText Text="既定の色に戻す(_D)" /></Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" MinWidth="96" Padding="12,6" IsDefault="True" Click="Ok_Click" />
                <Button Content="キャンセル" MinWidth="96" Padding="12,6" Margin="10,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
