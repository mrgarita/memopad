<Window x:Class="Memopad.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemoPad について"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="MemoPad" FontSize="24" FontWeight="Bold" />
        <TextBlock x:Name="VersionText" Margin="0,4,0,12" Opacity="0.8" />
        <TextBlock TextWrapping="Wrap" Text="Windows のメモ帳の機能はそのままに、背景色・文字色・フォントを自由に変えられるテキスト エディタ。" />
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
            <Run Text="設定ファイル：" /><Run x:Name="SettingsPathText" />
        </TextBlock>
        <Button Content="OK" MinWidth="96" HorizontalAlignment="Right" Margin="0,20,0,0" IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
