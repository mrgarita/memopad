<Window x:Class="Memopad.Dialogs.ColorSchemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配色パターン"
        Width="720" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
        目に優しい配色 16 パターン（step3 FB-4）。背景色と文字色を一度に変える。
        各パターンをカードで見せ、クリックで選ぶ。下のプレビューには現在のフォントで見本文を出す。
        高さは 1920×1080・表示スケール 150% の作業領域（論理 672 px）に収まるように詰めてある（FB-26）。
        それより低い画面では、コンストラクターが作業領域の高さを MaxHeight に入れ、パターンの一覧だけがスクロールする。
    -->
    <Window.Resources>
        <!-- パターンのカード。背景はパターンの背景色、文字はパターンの文字色。選択中は太い枠 -->
        <Style x:Key="CardStyle" TargetType="Button">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="70" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#80808080" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C0808080" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <!-- 画面に入りきらないときは、この行（パターンの一覧）だけが縮んでスクロールする。OK とキャンセルは常に見える -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <GroupBox Header="ライト（明るい背景）" Padding="6,4">
                    <UniformGrid x:Name="LightCards" Columns="4" HorizontalAlignment="Left" />
                </GroupBox>
                <GroupBox Header="ダーク（暗い背景）" Padding="6,4" Margin="0,8,0,0">
                    <UniformGrid x:Name="DarkCards" Columns="4" HorizontalAlignment="Left" />
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <GroupBox Grid.Row="1" Header="プレビュー" Margin="0,8,0,0" Padding="8,6">
            <!-- 大きなフォントでもパターンの一覧を押しのけないよう、高さに上限を付けてはみ出しは切る -->
            <Border x:Name="PreviewBorder" MinHeight="64" MaxHeight="160" ClipToBounds="True" CornerRadius="4" BorderBrush="#80808080" BorderThickness="1" Padding="12,6">
                <DockPanel>
                    <TextBlock x:Name="PreviewName" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock x:Name="PreviewText" TextWrapping="Wrap"
                               Text="背景色と文字色を一度に変えられます。&#10;The quick brown fox jumps over the lazy dog. 0123456789" />
                </DockPanel>
            </Border>
        </GroupBox>

        <!-- 説明はボタンの左に置く（上に置くと 1 行ぶん高くなる） -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OkButton" Content="OK" MinWidth="96" Padding="12,6" IsDefault="True" Click="Ok_Click" />
                <Button Content="キャンセル" MinWidth="96" Padding="12,6" Margin="10,0,0,0" IsCancel="True" />
            </StackPanel>
            <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" Text="OK を押すと背景色と文字色が両方変わります。個別に変えるときは「色変更...」を使ってください。" />
        </DockPanel>
    </Grid>
</Window>
