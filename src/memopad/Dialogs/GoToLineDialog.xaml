<Window x:Class="Memopad.Dialogs.GoToLineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="行に移動"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <Label Content="行番号(_L):" Target="{Binding ElementName=LineTextBox}" Padding="0" Margin="0,0,0,6" />
        <TextBox x:Name="LineTextBox" Margin="0,0,0,4" />
        <TextBlock x:Name="RangeText" Opacity="0.7" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="96" Margin="0,0,8,0" IsDefault="True" Click="GoButton_Click">
                <AccessText Text="移動(_G)" />
            </Button>
            <Button Content="キャンセル" MinWidth="96" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
