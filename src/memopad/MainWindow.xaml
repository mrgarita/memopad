<Window x:Class="Memopad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Memopad"
        Title="memopad"
        MinWidth="420" MinHeight="300"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <!--
        タイトル バーを自前で描き、メモ帳と同じくタブをタイトル行に載せる。
        GlassFrameThickness は 0 にする（ガラス領域があると GDI で描く RichEdit が透ける）。
        キャプション ボタンは UseAeroCaptionButtons=False にして自分で置く。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- タイトル行とメニュー行の色（UpdateTabBrushes でテーマに合わせて差し替える） -->
        <SolidColorBrush x:Key="TitleBarBrush" Color="#E8E8E8" />
        <SolidColorBrush x:Key="MenuBarBrush" Color="#F9F9F9" />
        <!-- キャプション ボタン（最小化／最大化／閉じる）。Segoe Fluent Icons のグリフを使う -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource TabTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <!-- アイコン フォントはここだけに付ける（Button に付けるとツールチップまで継承して日本語が□になる） -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" TextElement.FontSize="10" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" TextElement.FontSize="10" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- タブの色。ライト／ダークの切り替え時に MainWindow.UpdateTabBrushes が差し替える -->
        <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TabHoverBrush" Color="#E6E6E6" />
        <SolidColorBrush x:Key="TabTextBrush" Color="#1B1B1B" />
        <!-- メニュー バー：メモ帳と同じ高さ（30 px）に詰める -->
        <SolidColorBrush x:Key="MenuPopupBrush" Color="#F9F9F9" />
        <SolidColorBrush x:Key="MenuPopupBorderBrush" Color="#E0E0E0" />
        <!--
            メニュー バーの項目（トップ レベル）。Fluent のテンプレートは高さが約 58 px あり、Menu の高さを
            30 px に固定すると項目が描画されなくなるため、簡素なテンプレートに差し替える。
            サブメニューの項目（PART_Popup の中身）は Fluent のテンプレートのまま。
        -->
        <Style x:Key="TopMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TabTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd" Margin="2,3" Padding="10,0" CornerRadius="4" Background="Transparent">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="0" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Margin="8" Padding="4" CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource MenuPopupBrush}" BorderBrush="{DynamicResource MenuPopupBorderBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" />
                                    </Border.Effect>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Window.CommandBindings>
        <!-- ファイル -->
        <CommandBinding Command="{x:Static local:Commands.NewTab}" Executed="NewTab_Executed" />
        <CommandBinding Command="{x:Static local:Commands.NewWindow}" Executed="NewWindow_Executed" />
        <CommandBinding Command="{x:Static local:Commands.Open}" Executed="Open_Executed" />
        <CommandBinding Command="{x:Static local:Commands.Save}" Executed="Save_Executed" />
        <CommandBinding Command="{x:Static local:Commands.SaveAs}" Executed="SaveAs_Executed" />
        <CommandBinding Command="{x:Static local:Commands.SaveAll}" Executed="SaveAll_Executed" />
        <CommandBinding Command="{x:Static local:Commands.PageSetup}" Executed="PageSetup_Executed" />
        <CommandBinding Command="{x:Static local:Commands.Print}" Executed="Print_Executed" />
        <CommandBinding Command="{x:Static local:Commands.CloseTab}" Executed="CloseTab_Executed" />
        <CommandBinding Command="{x:Static local:Commands.CloseWindow}" Executed="CloseWindow_Executed" />
        <CommandBinding Command="{x:Static local:Commands.Exit}" Executed="CloseWindow_Executed" />
        <!-- 編集 -->
        <CommandBinding Command="{x:Static local:Commands.Find}" Executed="Find_Executed" />
        <CommandBinding Command="{x:Static local:Commands.FindNext}" Executed="FindNext_Executed" />
        <CommandBinding Command="{x:Static local:Commands.FindPrevious}" Executed="FindPrevious_Executed" />
        <CommandBinding Command="{x:Static local:Commands.Replace}" Executed="Replace_Executed" />
        <CommandBinding Command="{x:Static local:Commands.GoTo}" Executed="GoTo_Executed" />
        <CommandBinding Command="{x:Static local:Commands.InsertDateTime}" Executed="InsertDateTime_Executed" />
        <!-- 表示 -->
        <CommandBinding Command="{x:Static local:Commands.ZoomIn}" Executed="ZoomIn_Executed" />
        <CommandBinding Command="{x:Static local:Commands.ZoomOut}" Executed="ZoomOut_Executed" />
        <CommandBinding Command="{x:Static local:Commands.ZoomReset}" Executed="ZoomReset_Executed" />
        <CommandBinding Command="{x:Static local:Commands.ToggleStatusBar}" Executed="ToggleStatusBar_Executed" />
        <CommandBinding Command="{x:Static local:Commands.ToggleWordWrap}" Executed="ToggleWordWrap_Executed" />
        <!-- 書式 -->
        <CommandBinding Command="{x:Static local:Commands.Font}" Executed="Font_Executed" />
        <CommandBinding Command="{x:Static local:Commands.ChangeColors}" Executed="ChangeColors_Executed" />
        <CommandBinding Command="{x:Static local:Commands.ColorScheme}" Executed="ColorScheme_Executed" />
        <CommandBinding Command="{x:Static local:Commands.ResetColors}" Executed="ResetColors_Executed" />
        <!-- ヘルプ -->
        <CommandBinding Command="{x:Static local:Commands.About}" Executed="About_Executed" />
    </Window.CommandBindings>

    <Border x:Name="RootBorder">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    <DockPanel>
        <!-- タイトル行：アイコン／タブ／＋／キャプション ボタン。高さは WindowChrome の CaptionHeight と同じ 48 -->
        <Grid x:Name="TitleRow" DockPanel.Dock="Top" Height="42" Background="{DynamicResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="AppIcon" Grid.Column="0" Width="16" Height="16" Margin="12,0,4,0" VerticalAlignment="Center" />
            <ListBox x:Name="TabList" Grid.Column="1" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Bottom"
                     BorderThickness="0" Padding="0" Margin="0" Background="Transparent"
                     MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={x:Static local:MinusConverter.Instance}, ConverterParameter=230}"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="TabList_SelectionChanged"
                     PreviewMouseDown="TabList_PreviewMouseDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <!-- Fluent の ListBoxItem は余白が大きいので、タブ用の簡素なテンプレートに差し替える -->
                    <!-- Focusable は既定（True）のまま：ListBoxItem はクリック時にフォーカスを取れないと選択しない（v0.5.1 で修正） -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Margin="4,8,0,0" Padding="12,0,4,0" CornerRadius="6,6,0,0" Background="Transparent" MinWidth="120" Height="34">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Width="22" Height="22" Padding="0" Margin="8,0,0,0" FontSize="11"
                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TabTextBrush}"
                                    ToolTip="タブを閉じる (Ctrl+W)" Click="CloseTabButton_Click" />
                            <TextBlock Text="{Binding Document.TabTitle}" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TabTextBrush}" ToolTip="{Binding Document.FilePath}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="2" Content="＋" Width="30" Height="28" Margin="4,8,0,0" Padding="0" FontSize="15"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TabTextBrush}"
                    Command="{x:Static local:Commands.NewTab}" ToolTip="新しいタブ (Ctrl+N)" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" Click="Maximize_Click" ToolTip="最大化" />
                <Button Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;" Click="Close_Click" ToolTip="閉じる" />
            </StackPanel>
        </Grid>

        <!-- メニュー：項目とショートカットはメモ帳に合わせる -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Height="32" Margin="0" Background="{DynamicResource MenuBarBrush}" Padding="6,0">
            <MenuItem Header="ファイル(_F)" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="新しいタブ(_N)" Command="{x:Static local:Commands.NewTab}" />
                <MenuItem Header="新しいウィンドウ(_W)" Command="{x:Static local:Commands.NewWindow}" />
                <MenuItem Header="開く(_O)..." Command="{x:Static local:Commands.Open}" />
                <MenuItem x:Name="RecentFilesMenu" Header="最近使ったファイル(_R)" SubmenuOpened="RecentFilesMenu_SubmenuOpened">
                    <MenuItem Header="(なし)" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="保存(_S)" Command="{x:Static local:Commands.Save}" />
                <MenuItem Header="名前を付けて保存(_A)..." Command="{x:Static local:Commands.SaveAs}" />
                <MenuItem Header="すべて保存(_L)" Command="{x:Static local:Commands.SaveAll}" />
                <Separator />
                <MenuItem Header="ページ設定(_U)..." Command="{x:Static local:Commands.PageSetup}" />
                <MenuItem Header="印刷(_P)..." Command="{x:Static local:Commands.Print}" />
                <Separator />
                <MenuItem Header="タブを閉じる(_C)" Command="{x:Static local:Commands.CloseTab}" />
                <MenuItem Header="ウィンドウを閉じる(_E)" Command="{x:Static local:Commands.CloseWindow}" />
                <MenuItem Header="終了(_X)" Command="{x:Static local:Commands.Exit}" />
            </MenuItem>
            <!-- 編集：元に戻す〜削除はエディタ（RichEdit）が自前で処理するので Click で呼ぶ。有効／無効はメニューを開くときに更新する -->
            <MenuItem Header="編集(_E)" Style="{StaticResource TopMenuItemStyle}" SubmenuOpened="EditMenu_SubmenuOpened">
                <MenuItem x:Name="UndoMenuItem" Header="元に戻す(_U)" InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem x:Name="RedoMenuItem" Header="やり直し(_R)" InputGestureText="Ctrl+Y" Click="Redo_Click" />
                <Separator />
                <MenuItem x:Name="CutMenuItem" Header="切り取り(_T)" InputGestureText="Ctrl+X" Click="Cut_Click" />
                <MenuItem x:Name="CopyMenuItem" Header="コピー(_C)" InputGestureText="Ctrl+C" Click="Copy_Click" />
                <MenuItem x:Name="PasteMenuItem" Header="貼り付け(_P)" InputGestureText="Ctrl+V" Click="Paste_Click" />
                <MenuItem x:Name="DeleteMenuItem" Header="削除(_L)" InputGestureText="Del" Click="Delete_Click" />
                <Separator />
                <MenuItem Header="検索(_F)..." Command="{x:Static local:Commands.Find}" />
                <MenuItem Header="次を検索(_N)" Command="{x:Static local:Commands.FindNext}" />
                <MenuItem Header="前を検索(_V)" Command="{x:Static local:Commands.FindPrevious}" />
                <MenuItem Header="置換(_R)..." Command="{x:Static local:Commands.Replace}" />
                <MenuItem Header="行へ移動(_G)..." Command="{x:Static local:Commands.GoTo}" />
                <Separator />
                <MenuItem Header="すべて選択(_A)" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                <MenuItem Header="日付と時刻(_D)" Command="{x:Static local:Commands.InsertDateTime}" />
            </MenuItem>
            <MenuItem Header="表示(_V)" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="ズーム(_Z)">
                    <MenuItem Header="拡大(_I)" Command="{x:Static local:Commands.ZoomIn}" InputGestureText="Ctrl+プラス記号 (+)" />
                    <MenuItem Header="縮小(_O)" Command="{x:Static local:Commands.ZoomOut}" InputGestureText="Ctrl+マイナス記号 (-)" />
                    <MenuItem Header="既定の倍率に戻す(_R)" Command="{x:Static local:Commands.ZoomReset}" InputGestureText="Ctrl+0" />
                </MenuItem>
                <MenuItem x:Name="StatusBarMenuItem" Header="ステータス バー(_S)" IsCheckable="True" Command="{x:Static local:Commands.ToggleStatusBar}" />
                <MenuItem x:Name="WordWrapMenuItem" Header="右端で折り返す(_W)" IsCheckable="True" Command="{x:Static local:Commands.ToggleWordWrap}" />
            </MenuItem>
            <!-- 書式：memopad の追加機能（色変更）とフォント・テーマ -->
            <MenuItem Header="書式(_O)" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="フォント(_F)..." Command="{x:Static local:Commands.Font}" />
                <Separator />
                <MenuItem Header="色変更(_C)..." Command="{x:Static local:Commands.ChangeColors}" />
                <MenuItem Header="配色パターン(_P)..." Command="{x:Static local:Commands.ColorScheme}" />
                <MenuItem Header="既定の色に戻す(_D)" Command="{x:Static local:Commands.ResetColors}" />
                <Separator />
                <MenuItem Header="テーマ(_M)">
                    <MenuItem x:Name="ThemeLightMenuItem" Header="ライト(_L)" IsCheckable="True" Tag="Light" Click="ThemeMenuItem_Click" />
                    <MenuItem x:Name="ThemeDarkMenuItem" Header="ダーク(_D)" IsCheckable="True" Tag="Dark" Click="ThemeMenuItem_Click" />
                    <MenuItem x:Name="ThemeSystemMenuItem" Header="システム設定を使用する(_S)" IsCheckable="True" Tag="System" Click="ThemeMenuItem_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)" Style="{StaticResource TopMenuItemStyle}">
                <MenuItem Header="memopad について(_A)" Command="{x:Static local:Commands.About}" />
            </MenuItem>
        </Menu>

        <!-- ステータスバー：行・列／文字数／ズーム／改行コード／エンコード（メモ帳と同じ並び） -->
        <StatusBar x:Name="StatusBar" DockPanel.Dock="Bottom" Height="32" Padding="4,0" FontSize="12">
            <StatusBar.Resources>
                <Style TargetType="StatusBarItem">
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Margin" Value="0,8" />
                </Style>
            </StatusBar.Resources>
            <StatusBarItem>
                <TextBlock x:Name="PositionText" Text="行 1、列 1" MinWidth="110" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="CharCountText" Text="0 文字" MinWidth="80" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ZoomText" Text="100%" MinWidth="50" Margin="0,0,16,0" />
                    <TextBlock x:Name="LineEndingText" Text="Windows (CRLF)" MinWidth="120" Margin="0,0,16,0"
                               Cursor="Hand" ToolTip="クリックして改行コードを変更" MouseLeftButtonUp="LineEndingText_Click" />
                    <TextBlock x:Name="EncodingText" Text="UTF-8" MinWidth="110"
                               Cursor="Hand" ToolTip="クリックしてエンコードを変更" MouseLeftButtonUp="EncodingText_Click" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- 検索／置換バー：Ctrl+F / Ctrl+H で表示、Esc で閉じる -->
        <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="8,6" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <!-- 1 行目：検索語と前後ボタン、2 行目：置換（置換モードのみ）、3 行目：オプションと結果 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="検索:" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="40" />
                <TextBox x:Name="FindTextBox" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" MinWidth="200" MaxWidth="480" HorizontalAlignment="Left"
                         Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={x:Static local:HalfWidthConverter.Instance}}"
                         KeyDown="FindTextBox_KeyDown" TextChanged="FindTextBox_TextChanged" />
                <Button Grid.Row="0" Grid.Column="2" Content="↓ 次へ" MinWidth="90" Margin="6,0,0,0" Click="FindNextButton_Click" ToolTip="次を検索 (F3)" />
                <Button x:Name="FindPreviousButton" Grid.Row="0" Grid.Column="3" Content="↑ 前へ" MinWidth="90" Margin="6,0,0,0" Click="FindPreviousButton_Click" ToolTip="前を検索 (Shift+F3)" />
                <Button Grid.Row="0" Grid.Column="4" MinWidth="40" Padding="0" Margin="12,0,0,0" Height="{Binding ActualHeight, ElementName=FindPreviousButton}" Click="CloseFindBar_Click" ToolTip="閉じる (Esc)">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>

                <TextBlock x:Name="ReplaceLabel" Grid.Row="1" Grid.Column="0" Text="置換:" VerticalAlignment="Center" Margin="0,6,8,0" />
                <TextBox x:Name="ReplaceTextBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,6,0,0" MinWidth="200" MaxWidth="480" HorizontalAlignment="Left"
                         Width="{Binding ActualWidth, ElementName=FindTextBox}" KeyDown="ReplaceTextBox_KeyDown" />
                <Button x:Name="ReplaceButton" Grid.Row="1" Grid.Column="2" Content="置換" MinWidth="90" Margin="6,6,0,0" Click="ReplaceButton_Click" />
                <Button x:Name="ReplaceAllButton" Grid.Row="1" Grid.Column="3" Content="すべて置換" MinWidth="90" Margin="6,6,0,0" Click="ReplaceAllButton_Click" />

                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="MatchCaseCheckBox" Content="大文字と小文字を区別する" VerticalAlignment="Center" />
                    <CheckBox x:Name="WrapAroundCheckBox" Content="折り返す" Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="True" />
                    <TextBlock x:Name="FindStatusText" Margin="20,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 編集領域（残り全部） -->
        <ContentControl x:Name="EditorHost" Focusable="False" />
    </DockPanel>
    </Border>
</Window>
